# 接続先。未設定ならローカル (docker compose) の既定値を使う
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 1 で TLS 接続 (ElastiCache の転送中暗号化を有効にした場合など)。本リポジトリの CDK は無効で作る
REDIS_TLS=0

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=demo
MYSQL_PASSWORD=demo
MYSQL_DATABASE=demo
# 空/0: TLS なし、rds: mysql2 内蔵の "Amazon RDS" CA プロファイル、insecure: 検証なし TLS
MYSQL_SSL=
